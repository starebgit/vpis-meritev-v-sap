<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7" />
  </startup>
  <appSettings>
    <add key="sap.destination.name" value="SAP_DEFAULT" />
    <!-- Required for SAP connection -->
    <add key="sap.ashost" value="" />
    <add key="sap.sysnr" value="00" />
    <add key="sap.client" value="100" />
    <add key="sap.user" value="" />
    <add key="sap.passwd" value="" />
    <add key="sap.lang" value="EN" />
    <!-- Optional pool tuning -->
    <add key="sap.pool_size" value="5" />
    <add key="sap.max_pool_size" value="10" />
    <add key="sap.idle_timeout" value="600" />
    <add key="sap.peak_connections_limit" value="20" />
    <!-- Optional smoke RFC/BAPI name (default: RFC_SYSTEM_INFO) -->
    <add key="sap.smoke.rfc" value="RFC_SYSTEM_INFO" />
  </appSettings>
  <runtime>
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
      <dependentAssembly>
        <assemblyIdentity name="Microsoft.CSharp" publicKeyToken="b03f5f7f11d50a3a" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-5.0.0.0" newVersion="5.0.0.0" />
      </dependentAssembly>
    </assemblyBinding>
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
      <dependentAssembly>
        <assemblyIdentity name="System.ComponentModel.Annotations" publicKeyToken="b03f5f7f11d50a3a" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-5.0.0.0" newVersion="5.0.0.0" />
      </dependentAssembly>
    </assemblyBinding>
  </runtime>
</configuration>