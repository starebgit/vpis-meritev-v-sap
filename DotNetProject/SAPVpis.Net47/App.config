<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7" />
  </startup>

  <appSettings>
    <add key="sap.destination.name" value="SAP_DEFAULT" />

    <!-- Delphi-compatible login source (table prijava where glavni='X') -->
    <add key="sap.login.db.connection_string" value="Provider=SQLOLEDB.1;Data Source=172.20.1.14;Initial Catalog=SAPkontrola;User ID=sap;Password=sap" />

    <!-- Optional pool tuning -->
    <add key="sap.pool_size" value="5" />
    <add key="sap.peak_connections_limit" value="20" />

    <!-- Optional smoke RFC/BAPI name (default: RFC_SYSTEM_INFO) -->
    <add key="sap.smoke.rfc" value="RFC_SYSTEM_INFO" />

    <add key="sap.step5.lot" value="30002292667" />
    <add key="sap.step5.language" value="5" />
    <add key="sap.step6.enable_post" value="false" />
    <add key="sap.step6.inspchar" value="0001" />
    <add key="sap.step6.result_value" value="0" />

  </appSettings>
</configuration>
