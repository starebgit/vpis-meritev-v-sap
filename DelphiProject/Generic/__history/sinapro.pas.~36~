Function TFsinapro.PreveriStroj(idstr: integer) : boolean ;
begin
   Adoquery1.sql.clear ;
   Adoquery1.sql.add('select * from  t_del_stanjestroj where st_stroj_ID  = :ZG') ;
   Adoquery1.Parameters[0].name := 'ZG' ;
   Adoquery1.Parameters[0].value := idstr ;
   try
     Adoquery1.open ;
   except
     result := false ;
     exit ;
   end;
   if adoquery1.FieldByName('cas_zacetek').isnull then result := false
   else
   begin
      if adoquery1.FieldByName('cas_zast_zacetek').isnull then result := true else result := false ;
   end ;
   Adoquery1.Close ;
end;


function TFsinapro.Getkolic(kd: string;id : integer ; dt,ds : TdateTime) : integer;
  var deln: string ;
      ii,ll,jx,j : Integer ;
      lista : TstringList ;
      izd,stnal : string ;
      sum,summ : integer ;
      excel : variant ;
      dt1,dt2 : TdateTime ;
begin
   excel := GetActiveOLEObject('Excel.application.15');
   AdoQuery1.SQL.Clear ;
   AdoQuery1.sql.Add('Select * from t_pod_izdelek where klasifikacija = :ID') ;
   AdoQuery1.Parameters[0].value := kd ;
   AdoQuery1.Parameters[0].name := 'ID' ;
   AdoQuery1.Open ;
   izd := Adoquery1.FieldByName('st_izdelek_ID').Value ;
   adoquery1.Close ;

    AdoQuery1.SQL.Clear ;
    AdoQuery1.sql.Add('Select * from t_pod_delnalog where (st_izdelek_id = :ID) and (cas_zacetek <= :DAT) and (cas_konec >= :DAS)') ;
    AdoQuery1.Parameters[0].value := izd ;
    AdoQuery1.Parameters[0].name := 'ID' ;
    AdoQuery1.Parameters[1].value := ds+20 ;
    AdoQuery1.Parameters[1].name := 'DAT' ;
    AdoQuery1.Parameters[2].value := dt-20 ;
    AdoQuery1.Parameters[2].name := 'DAS' ;
    AdoQuery1.Open ;

    for j := 1  to 31 do
    begin
      sum := 0 ;
      summ := 0 ;
      dt1 := dt + j -1 ;
      dt2 := dt + j ;
      AdoQuery1.first ;
      while not Adoquery1.eof do
      begin
        stnal := Adoquery1.FieldByName('st_delnal_ID').Value ;
        AdoQuery2.SQL.Clear ;
        AdoQuery2.sql.Add('Select SUM(kol_kosi_vsi) as sm, sum(kol_kosi_izmet) as smm from t_del_proiz where (st_stroj_ID = :ID) and (cas_vpis >= :DAT) and (cas_vpis < :DAS) and (st_delNal_id = :STN) ') ;
        AdoQuery2.Parameters[0].value := id ;
        AdoQuery2.Parameters[0].name := 'ID' ;
        AdoQuery2.Parameters[1].value := dt1 ;
        AdoQuery2.Parameters[1].name := 'DAT' ;
        AdoQuery2.Parameters[2].value := dt2  ;
        AdoQuery2.Parameters[2].name := 'DAS' ;
        AdoQuery2.Parameters[3].value := stnal  ;
        AdoQuery2.Parameters[3].name := 'STN' ;
        AdoQuery2.Open ;
        sum  := sum + Adoquery2.fieldByname('sm').ASiNTEGER ;
        summ  := summ + Adoquery2.fieldByname('smm').ASiNTEGER ;
        Adoquery2.close ;
        adoquery1.Next ;
      end;
     // excel.cells[j,1] := dt1 ;
      excel.cells[j,4] := sum ;
      excel.cells[j,5] := summ ;

   end ;
   adoquery1.Close ;
   result := sum ;
end;

end.
