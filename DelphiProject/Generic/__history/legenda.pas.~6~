unit legenda;

interface

uses
  Winapi.Windows, Winapi.Messages, System.SysUtils, System.Variants, System.Classes, Vcl.Graphics,
  Vcl.Controls, Vcl.Forms, Vcl.Dialogs, Vcl.StdCtrls, Vcl.ExtCtrls;

type
  TFlegenda = class(TForm)
    Panel1: TPanel;
    Panel2: TPanel;
    Edit1: TEdit;
    Edit2: TEdit;
    Edit3: TEdit;
    Button1: TButton;
    Panel3: TPanel;
    Edit4: TEdit;
    Edit5: TEdit;
  private
    { Private declarations }
  public
    Procedure prikaz(op : integer) ;
  end;

var
  Flegenda: TFlegenda;

implementation

{$R *.dfm}

Procedure Tflegenda.prikaz(op : integer) ;
begin
  if op = 1  then
  begin
    edit1.text := 'Izven tolerance' ;
    edit2.text := 'Izven kontrolnih meja' ;
    edit3.text := 'Normalna meritev' ;
    edit2.Color := clYellow ;
    edit3.Visible := true ;
  end else
  begin
    edit1.Text := 'Število slabih' ;
    edit2.Text := 'Vsi dobri' ;
    edit2.Color := clWhite ;
    edit3.visible := false
  end ;
  showModal ;
end;

end.
