unit Vpiskar;

interface

uses
  Winapi.Windows, Winapi.Messages, System.SysUtils, System.Variants, System.Classes, Vcl.Graphics,
  Vcl.Controls, Vcl.Forms, Vcl.Dialogs, Vcl.StdCtrls, Vcl.ExtCtrls;

type
  TFvpiskar = class(TForm)
    Panel1: TPanel;
    CheckBox1: TCheckBox;
    CheckBox2: TCheckBox;
    CheckBox3: TCheckBox;
    CheckBox4: TCheckBox;
    CheckBox5: TCheckBox;
    CheckBox6: TCheckBox;
    CheckBox7: TCheckBox;
    CheckBox8: TCheckBox;
    CheckBox9: TCheckBox;
    CheckBox10: TCheckBox;
    CheckBox11: TCheckBox;
    Button1: TButton;
    Button2: TButton;
    Label1: TLabel;
    Button3: TButton;
    procedure Button1Click(Sender: TObject);
    procedure Button2Click(Sender: TObject);
    procedure Button3Click(Sender: TObject);
  private
    stran : integer ;
    stk : integer ;
    listAcc : TstringList ;
    procedure SetStran ;
    procedure preberi ;
  public

    Procedure Vpis(stkar : integer;var ListA : TstringList) ;
  end;

var
  Fvpiskar: TFvpiskar;

implementation

{$R *.dfm}

Procedure TFVpiskar.Vpis(stkar : integer; var ListA : TstringList) ;
  var i : integer ;
begin
  stk := stkar ;
  Stran := 1 ;
  listAcc := ListA ;
  for i := 1 to stkar do listAcc.Add('') ;
  setStran;
  ShowModal ;
  //listAcc.Free ;
end;

procedure TFvpiskar.preberi ;
 var i1,i2,ii,jj : integer ;
      imm : string ;
      kmp : TcheckBox ;
begin
  for ii  := 1 to 10 do
  begin
    jj :=  (stran-1)*10 + ii ;
    imm := 'CheckBox' + IntTostr(ii) ;
    kmp := TCheckBox(FindComponent(imm)) ;
    if jj <= stk then
    begin
      if kmp.checked then listAcc[jj-1] := 'A' else listAcc[jj-1] := '' ;
    end;
  end;
end ;

procedure TFvpiskar.Button1Click(Sender: TObject);
begin
  if stran*10 > stk then exit ;
  preberi ;
  inc(stran) ;
  SetStran ;
end;

procedure TFvpiskar.Button2Click(Sender: TObject);
begin
  if stran = 1 then exit  ;
  preberi ;
  stran := stran -1 ;
  SetStran ;
end;

procedure TFvpiskar.Button3Click(Sender: TObject);
begin
   preberi ;
   Close ;
end;

procedure TfVpiskar.SetStran ;
  var i1,i2,ii,jj : integer ;
      imm : string ;
      kmp : TcheckBox ;
begin
  label1.Caption := 'Stran ' + IntTostr(stran) ;
  i1 := (stran-1)*10 + 1 ;
  i2 := i1 + 9 ;

  for ii  := 1 to 10 do
  begin
    jj :=  (stran-1)*10 + ii ;
    imm := 'CheckBox' + IntTostr(ii) ;
    kmp := TCheckBox(FindComponent(imm)) ;
    kmp.visible := true ;

    if jj <= stk then
    begin
      kmp.caption := 'Izdelek št. ' + IntTostr(jj) ;
      if listAcc[jj-1] = 'A' then kmp.Checked := true else kmp.Checked := false
    end else
      kmp.visible := false ;
  end;


end;

end.
